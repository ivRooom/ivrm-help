const statusLabels: Record<ModStatus, string> = {
  installed: '導入済み',
  planned: '導入予定',
  waiting: '対応待ち',
};

const sideLabels: Record<ModSide, string> = {
  both: 'サーバー＋クライアント',
  server: 'サーバーのみ',
  client: 'クライアントのみ',
};

const installedCount = mods.filter((mod) => mod.status === 'installed').length;
const plannedCount = mods.filter((mod) => mod.status === 'planned').length;
const waitingCount = mods.filter((mod) => mod.status === 'waiting').length;
const categories = [...new Set(mods.map((mod) => mod.category))];
---

<section class="mod-catalog" data-mod-catalog>
  <div class="mod-catalog__summary" aria-label="MOD一覧の集計">
    <div>
      <span>公開カタログ</span>
      <strong>{mods.length}</strong>
      <small>MOD・依存ライブラリ</small>
    </div>
    <div>
      <span>現在の構成</span>
      <strong>{installedCount}</strong>
      <small>導入済みとして掲載</small>
    </div>
    <div>
      <span>拡張計画</span>
      <strong>{plannedCount}</strong>
      <small>導入・検証予定</small>
    </div>
    <div>
      <span>対応待ち</span>
      <strong>{waitingCount}</strong>
      <small>旧版を流用しない</small>
    </div>
  </div>

  <div class="mod-catalog__notice">
    <strong>一覧の読み方</strong>
    <p>
      「導入済み」は安定構成または配布クライアントで利用するもの、
      「導入予定」は本番反映・接続試験が残っているものです。
      JAR数には内部ライブラリも含まれるため、この公開カタログの件数とは一致しない場合があります。
    </p>
  </div>

  <div class="mod-catalog__controls" aria-label="MOD一覧の絞り込み">
    <label>
      <span>名前・説明から検索</span>
      <input type="search" placeholder="例: 農業、AE2、ボイスチャット" data-mod-search />
    </label>
    <label>
      <span>カテゴリ</span>
      <select data-mod-category>
        <option value="">すべて</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
    </label>
    <label>
      <span>導入先</span>
      <select data-mod-side>
        <option value="">すべて</option>
        <option value="both">サーバー＋クライアント</option>
        <option value="server">サーバーのみ</option>
        <option value="client">クライアントのみ</option>
      </select>
    </label>
    <label>
      <span>状態</span>
      <select data-mod-status>
        <option value="">すべて</option>
        <option value="installed">導入済み</option>
        <option value="planned">導入予定</option>
        <option value="waiting">対応待ち</option>
      </select>
    </label>
  </div>

  <div class="mod-catalog__result-line" aria-live="polite">
    <span><strong data-mod-result-count>{mods.length}</strong>件を表示</span>
    <button type="button" data-mod-reset>絞り込みを解除</button>
  </div>

  <div class="mod-catalog__grid">
    {mods.map((mod) => (
      <article
        class="mod-card"
        data-mod-item
        data-name={`${mod.name} ${mod.summary} ${mod.details}`.toLowerCase()}
        data-category={mod.category}
        data-side={mod.side}
        data-status={mod.status}
      >
        <header>
          <div>
            <span class:list={['mod-card__status', `is-${mod.status}`]}>
              {statusLabels[mod.status]}
            </span>
            <span class="mod-card__category">{mod.category}</span>
          </div>
          <h2>{mod.name}</h2>
          <p>{mod.summary}</p>
        </header>
        <dl>
          <div>
            <dt>バージョン</dt>
            <dd>{mod.version}</dd>
          </div>
          <div>
            <dt>導入先</dt>
            <dd>{sideLabels[mod.side]}</dd>
          </div>
        </dl>
        <p class="mod-card__details">{mod.details}</p>
      </article>
    ))}
  </div>

  <p class="mod-catalog__empty" data-mod-empty hidden>
    条件に一致するMODがありません。検索語または絞り込み条件を変更してください。
  </p>
</section>

<style>
  .mod-catalog { display: grid; gap: 1.4rem; margin-block: 1.5rem 3rem; }
  .mod-catalog__summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; }
  .mod-catalog__summary > div { padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.9rem; background: var(--sl-color-bg-nav); }
  .mod-catalog__summary span, .mod-catalog__summary small { display: block; color: var(--sl-color-gray-2); }
  .mod-catalog__summary strong { display: block; margin-block: 0.25rem; color: var(--sl-color-text); font-size: 1.85rem; line-height: 1; }
  .mod-catalog__notice { padding: 1rem 1.1rem; border-inline-start: 0.25rem solid var(--sl-color-accent); background: var(--sl-color-accent-low); }
  .mod-catalog__notice p { margin: 0.35rem 0 0; }
  .mod-catalog__controls { display: grid; grid-template-columns: minmax(14rem, 1.6fr) repeat(3, minmax(9rem, 1fr)); gap: 0.75rem; align-items: end; }
  .mod-catalog__controls label { display: grid; gap: 0.35rem; color: var(--sl-color-gray-2); font-size: 0.85rem; font-weight: 600; }
  .mod-catalog__controls input, .mod-catalog__controls select { width: 100%; min-height: 2.65rem; padding: 0.65rem 0.75rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.65rem; color: var(--sl-color-text); background: var(--sl-color-bg); font: inherit; }
  .mod-catalog__controls input:focus, .mod-catalog__controls select:focus { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .mod-catalog__result-line { display: flex; gap: 0.35rem; align-items: center; justify-content: space-between; color: var(--sl-color-gray-2); }
  .mod-catalog__result-line strong { color: var(--sl-color-text); }
  .mod-catalog__result-line button { border: 0; color: var(--sl-color-accent-high); background: transparent; cursor: pointer; font: inherit; font-weight: 600; }
  .mod-catalog__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .mod-card { display: grid; align-content: start; gap: 1rem; padding: 1.1rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.9rem; background: var(--sl-color-bg-nav); }
  .mod-card[hidden] { display: none; }
  .mod-card header > div { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.65rem; }
  .mod-card h2 { margin: 0; font-size: 1.15rem; }
  .mod-card header p { margin: 0.4rem 0 0; color: var(--sl-color-gray-2); }
  .mod-card__status, .mod-card__category { display: inline-flex; align-items: center; min-height: 1.6rem; padding-inline: 0.55rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
  .mod-card__status { color: var(--sl-color-accent-high); background: var(--sl-color-accent-low); }
  .mod-card__status.is-planned { color: var(--sl-color-orange-high); background: var(--sl-color-orange-low); }
  .mod-card__status.is-waiting { color: var(--sl-color-gray-1); background: var(--sl-color-gray-6); }
  .mod-card__category { color: var(--sl-color-gray-2); background: var(--sl-color-gray-6); }
  .mod-card dl { display: grid; gap: 0.55rem; margin: 0; }
  .mod-card dl > div { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr); gap: 0.6rem; padding-block: 0.45rem; border-block-end: 1px solid var(--sl-color-gray-6); }
  .mod-card dt { color: var(--sl-color-gray-2); font-size: 0.8rem; font-weight: 700; }
  .mod-card dd { margin: 0; overflow-wrap: anywhere; }
  .mod-card__details { margin: 0; }
  .mod-catalog__empty { padding: 2rem 1rem; text-align: center; color: var(--sl-color-gray-2); border: 1px dashed var(--sl-color-gray-5); border-radius: 0.9rem; }
  @media (max-width: 52rem) {
    .mod-catalog__summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mod-catalog__controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 36rem) {
    .mod-catalog__summary, .mod-catalog__controls, .mod-catalog__grid { grid-template-columns: 1fr; }
    .mod-catalog__result-line { align-items: flex-start; flex-direction: column; }
  }
</style>

<script>
  const bindModCatalog = () => {
    document.querySelectorAll<HTMLElement>('[data-mod-catalog]').forEach((catalog) => {
      if (catalog.dataset.bound === 'true') return;
      catalog.dataset.bound = 'true';

      const search = catalog.querySelector<HTMLInputElement>('[data-mod-search]');
      const category = catalog.querySelector<HTMLSelectElement>('[data-mod-category]');
      const side = catalog.querySelector<HTMLSelectElement>('[data-mod-side]');
      const status = catalog.querySelector<HTMLSelectElement>('[data-mod-status]');
      const reset = catalog.querySelector<HTMLButtonElement>('[data-mod-reset]');
      const count = catalog.querySelector<HTMLElement>('[data-mod-result-count]');
      const empty = catalog.querySelector<HTMLElement>('[data-mod-empty]');
      const items = [...catalog.querySelectorAll<HTMLElement>('[data-mod-item]')];

      if (!search || !category || !side || !status || !reset || !count || !empty) return;

      const apply = () => {
        const query = search.value.trim().toLowerCase();
        let visible = 0;

        items.forEach((item) => {
          const matches =
            (!query || item.dataset.name?.includes(query)) &&
            (!category.value || item.dataset.category === category.value) &&
            (!side.value || item.dataset.side === side.value) &&
            (!status.value || item.dataset.status === status.value);

          item.hidden = !matches;
          if (matches) visible += 1;
        });

        count.textContent = String(visible);
        empty.hidden = visible !== 0;
      };

      [search, category, side, status].forEach((control) => {
        control.addEventListener(control === search ? 'input' : 'change', apply);
      });

      reset.addEventListener('click', () => {
        search.value = '';
        category.value = '';
        side.value = '';
        status.value = '';
        apply();
        search.focus();
      });

      apply();
    });
  };

  document.addEventListener('astro:page-load', bindModCatalog);
  bindModCatalog();
</script>
